// Définir la fonction dans le scope global, mais ne pas l'exécuter immédiatement
window.initializeServiceScripts = function () {
    if (typeof window.cookieConsent === 'undefined') {
        return;
    }

    // Enregistrer Google Analytics
    if (typeof GOOGLE_ANALYTICS_ID !== 'undefined' && GOOGLE_ANALYTICS_ID) {
        window.cookieConsent.registerScript('statistics', 'google_analytics', () => {
            // Update Google Analytics consent
            gtag('consent', 'update', {
                'analytics_storage': 'granted'
            });
        });
    }

    // Enregistrer Google Ads
    if (typeof GOOGLE_ADS_ID !== 'undefined' && GOOGLE_ADS_ID) {
        window.cookieConsent.registerScript('marketing', 'google_ads', () => {
            // Update Google Ads consent
            gtag('consent', 'update', {
                'ad_storage': 'granted',
                'ad_user_data': 'granted',
                'ad_personalization': 'granted'
            });
        });
    }

    // Enregistrer Bing Ads
    if (typeof BING_ADS_ID !== 'undefined' && BING_ADS_ID) {
        window.cookieConsent.registerScript('marketing', 'bing_ads', () => {
            // Update Bing Ads consent
            window.uetq = window.uetq || [];
            window.uetq.push('consent', 'update', {
                'ad_storage': 'granted'
            });
        });
    }

    // Enregistrer Meta Pixel
    if (typeof META_ID !== 'undefined' && META_ID) {
        window.cookieConsent.registerScript('marketing', 'meta', () => {
            // Code Meta Pixel
            !function (f, b, e, v, n, t, s) {
                if (f.fbq) return;
                n = f.fbq = function () {
                    n.callMethod ?
                        n.callMethod.apply(n, arguments) : n.queue.push(arguments)
                };
                if (!f._fbq) f._fbq = n;
                n.push = n;
                n.loaded = !0;
                n.version = '2.0';
                n.queue = [];
                t = b.createElement(e);
                t.async = !0;
                t.src = v;
                s = b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t, s)
            }(window, document, 'script',
                'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', META_ID);
            fbq('track', 'PageView');
        });
    }

    // Enregistrer LinkedIn Insight
    if (typeof LINKEDIN_ID !== 'undefined' && LINKEDIN_ID) {
        window.cookieConsent.registerScript('marketing', 'linkedin', () => {
            // Code LinkedIn Insight
            window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
            window._linkedin_data_partner_ids.push(LINKEDIN_ID);
            (function (l) {
                if (!l) {
                    window.lintrk = function (a, b) {
                        window.lintrk.q.push([a, b])
                    };
                    window.lintrk.q = []
                }
                var s = document.getElementsByTagName("script")[0];
                var b = document.createElement("script");
                b.type = "text/javascript";
                b.async = true;
                b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
                s.parentNode.insertBefore(b, s);
            })(window.lintrk);
        });
    }

    // Enregistrer Hotjar
    if (typeof HOTJAR_ID !== 'undefined' && HOTJAR_ID) {
        window.cookieConsent.registerScript('statistics', 'hotjar', () => {
            // Code Hotjar
            (function (h, o, t, j, a, r) {
                h.hj = h.hj || function () {
                    (h.hj.q = h.hj.q || []).push(arguments)
                };
                h._hjSettings = {hjid: HOTJAR_ID, hjsv: 6};
                a = o.getElementsByTagName('head')[0];
                r = o.createElement('script');
                r.async = 1;
                r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
                a.appendChild(r);
            })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
        });
    }

    // Enregistrer HubSpot
    if (typeof HUBSPOT_ID !== 'undefined' && HUBSPOT_ID) {
        window.cookieConsent.registerScript('marketing', 'hubspot', () => {
            // Code HubSpot
            var script = document.createElement('script');
            script.async = true;
            script.defer = true;
            script.id = 'hs-script-loader';
            script.src = 'https://js-eu1.hs-scripts.com/'+HUBSPOT_ID+'.js';
            if (window.location.hostname === 'cegoc.pt') {
                script.src += '?businessUnitId=16476043';
            }
            document.head.appendChild(script);
        });
    }

    // Enregistrer AB Tasty
    if (typeof AB_TASTY_ID !== 'undefined' && AB_TASTY_ID) {
        window.cookieConsent.registerScript('marketing', 'ab_tasty', () => {
            // Code AB Tasty
            (function (i, s, o, g, r, a, m) {
                i["abtiming"] = 1 * new Date();
                a = s.createElement(o),
                    m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
            })(window, document, "script", "//try.abtasty.com/"+AB_TASTY_ID+".js");
        });
    }

	// Enregister ActiveCampaign
	if (typeof ACTIVE_CAMPAIGN_ID !== 'undefined' && ACTIVE_CAMPAIGN_ID) {
		(function(e,t,o,n,p,r,i){e.visitorGlobalObjectAlias=n;e[e.visitorGlobalObjectAlias]=e[e.visitorGlobalObjectAlias]||function(){(e[e.visitorGlobalObjectAlias].q=e[e.visitorGlobalObjectAlias].q||[]).push(arguments)};e[e.visitorGlobalObjectAlias].l=(new Date).getTime();r=t.createElement("script");r.src=o;r.async=true;i=t.getElementsByTagName("script")[0];i.parentNode.insertBefore(r,i)})(window,document,"https://diffuser-cdn.app-us1.com/diffuser/diffuser.js","vgo");
		vgo('setAccount', ACTIVE_CAMPAIGN_ID);
		vgo('setTrackByDefault', true);
		vgo('process');
	}

    // Enregistrer LeadLab
    if (typeof LEADLAB_ID !== 'undefined' && LEADLAB_ID) {
        window.cookieConsent.registerScript('marketing', 'leadlab', () => {
            // Code LeadLab
            (function (d, s) {
                var l = d.createElement(s), e = d.getElementsByTagName(s)[0];
                l.async = true;
                l.type = 'text/javascript';
                l.src = 'https://c.leadlab.click/'+LEADLAB_ID+'.js';
                e.parentNode.insertBefore(l, e);
            })(document, 'script');
        });
    }

    // Enregistrer Marketo
    if (typeof MARKETO_ID !== 'undefined' && MARKETO_ID) {
        window.cookieConsent.registerScript('marketing', 'marketo', () => {
            // Code Marketo
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    'gtm.start':
                        new Date().getTime(), event: 'gtm.js'
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                var n = d.querySelector('[nonce]');
                n && j.setAttribute('nonce', n.nonce || n.getAttribute('nonce'));
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-M2BHMS7');
        });
    }

    // Enregistrer ClearBit
    if (typeof CLEARBIT_ID !== 'undefined' && CLEARBIT_ID) {
        window.cookieConsent.registerScript('marketing', 'clearbit', () => {
            // Code ClearBit
            var script = document.createElement('script');
            script.async = true;
            script.src = "https://tag.clearbitscripts.com/v1/"+CLEARBIT_ID+"/tags.js";
            script.referrerPolicy = "strict-origin-when-cross-origin";
            document.head.appendChild(script);
        });
    }

	// Save Copper
	if (typeof COPPER_ID !== 'undefined' && COPPER_ID) {
		window.OFID = COPPER_ID;
		(function(){
			var script = document.createElement("script");
			var url = 'https://cdn.outfunnel.com/c.js?v='+ new Date().toISOString().substring(0,10);
			script.setAttribute('src', url);
			document.getElementsByTagName('head')[0].appendChild(script);
		})();
	}

    // Enregistrer Evalanche
    if (typeof EVALANCHE_ID !== 'undefined' && EVALANCHE_ID) {
        window.cookieConsent.registerScript('marketing', 'evalanche', () => {
            // Code Evalanche
            window.touchpointConfiguration = {
                id: EVALANCHE_ID,
                autotrack: true,
                timeout: 10,
                domain: 'scnem2.com',
                title: document.title
            };
            (function (tpc) {
                try {
                    var sn = document.getElementsByTagName('script')[0],
                        tp = document.createElement('script');
                    tp.type = 'text/javascript';
                    tp.id = 'ev_touchpoint';
                    tp.src = '//' + tpc.domain + '/ewaf/view/js/tp.js?';
                    sn.parentNode.insertBefore(tp, sn);
                } catch (e) {
                }
            })(touchpointConfiguration);
        });
    }

    // Enregistrer TikTok Pixel
    if (typeof TIKTOK_ID !== 'undefined' && TIKTOK_ID) {
        window.cookieConsent.registerScript('marketing', 'tiktok', () => {
            // Code TikTok Pixel
            !function (w, d, t) {
                w.TiktokAnalyticsObject = t;
                var ttq = w[t] = w[t] || [];
                ttq.methods = ["page", "track", "identify", "instances", "debug", "on", "off", "once", "ready", "alias", "group", "enableCookie", "disableCookie", "holdConsent", "revokeConsent", "grantConsent"], ttq.setAndDefer = function (t, e) {
                    t[e] = function () {
                        t.push([e].concat(Array.prototype.slice.call(arguments, 0)))
                    }
                };
                for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
                ttq.instance = function (t) {
                    for (var e = ttq._i[t] || [], n = 0; n < ttq.methods.length; n++) ttq.setAndDefer(e, ttq.methods[n]);
                    return e
                }, ttq.load = function (e, n) {
                    var r = "https://analytics.tiktok.com/i18n/pixel/events.js",
                        o = n && n.partner;
                    ttq._i = ttq._i || {}, ttq._i[e] = [], ttq._i[e]._u = r, ttq._t = ttq._t || {}, ttq._t[e] = +new Date, ttq._o = ttq._o || {}, ttq._o[e] = n || {};
                    n = document.createElement("script");
                    n.type = "text/javascript", n.async = !0, n.src = r + "?sdkid=" + e + "&lib=" + t;
                    e = document.getElementsByTagName("script")[0];
                    e.parentNode.insertBefore(n, e)
                };
                ttq.load(TIKTOK_ID);
                ttq.page();
            }(window, document, 'ttq');
        });
    }

    // Enregistrer LiveChat
    if (typeof LIVECHAT_ID !== 'undefined' && LIVECHAT_ID) {
        window.__lc = window.__lc || {};
        window.__lc.license = LIVECHAT_ID;
        (function () {
            var lc = document.createElement('script');
            lc.type = 'text/javascript';
            lc.async = true;
            lc.src = 'https://cdn.livechatinc.com/tracking.js';
            var s = document.getElementsByTagName('script')[0];
            s.parentNode.insertBefore(lc, s);
        })();
    }

    // Exemple de debug pour la catégorie "statistics"
    window.cookieConsent.registerScript('statistics', 'debug_statistics', () => {
        console.log('Debug Statistics: Script loaded');
    });

    // Exemple de debug pour la catégorie "marketing"
    window.cookieConsent.registerScript('marketing', 'debug_marketing', () => {
        console.log('Debug Marketing: Script loaded');
    });

    // Exemple de debug pour la catégorie "preferences"
    window.cookieConsent.registerScript('preferences', 'debug_preferences', () => {
        console.log('Debug Preferences: Script loaded');
    });

    document.dispatchEvent(new CustomEvent('serviceScriptsReady'));
};

// Initier l'enregistrement des scripts de façon sécurisée
document.addEventListener('DOMContentLoaded', () => {
    try {
        if (window.cookieConsent) {
            window.initializeServiceScripts();
        } else {
            document.addEventListener('cookieConsentReady', function () {
                window.initializeServiceScripts();
            });
        }
    } catch (e) {
        console.error("Erreur lors de l'initialisation des scripts de service:", e);
    }
});
